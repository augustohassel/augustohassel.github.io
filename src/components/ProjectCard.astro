---
import Card from './Card.astro';
import Badge from './Badge.astro';
import Button from './Button.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const hasLinks = Boolean(project.links && project.links.length > 0);
---

<Card variant="outlined" class="flex flex-col justify-between h-full space-y-5 transition-transform duration-200 hover:-translate-y-1">
  <div class="space-y-3">
    <!-- Encabezado de la tarjeta: Título y badge contextual -->
    <div class="flex items-start justify-between gap-3 flex-wrap">
      <h3 class="text-xl font-bold tracking-tight text-md-on-surface">
        {project.title}
      </h3>

      {project.badge && (
        <Badge variant={project.badge.variant ?? 'outline'} size="sm">
          {project.badge.text}
        </Badge>
      )}
    </div>

    <!-- Descripción del proyecto -->
    <p class="text-sm sm:text-base text-md-on-surface-variant leading-relaxed">
      {project.description}
    </p>

    <!-- Tags tecnológicos -->
    <div class="flex flex-wrap gap-1.5 pt-2" aria-label={`Tecnologías de ${project.title}`}>
      {project.tags.map((tag) => (
        <Badge variant="surface" size="sm">
          {tag}
        </Badge>
      ))}
    </div>
  </div>

  <!-- Acciones y Enlaces Externos -->
  <div class="pt-4 border-t border-md-outline-variant/20 flex flex-wrap items-center gap-2.5">
    {hasLinks && project.links!.map((link) => {
      const isDemo = link.type === 'demo';
      const isGithub = link.type === 'github';
      const isYoutube = link.type === 'youtube';

      return (
        <Button
          as="a"
          href={link.url}
          variant={isDemo ? 'filled' : 'tonal'}
          size="sm"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${link.label}: ${project.title} (abre en nueva pestaña)`}
        >
          {isGithub && (
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          )}

          {isYoutube && (
            <svg class="w-4 h-4 text-red-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          )}

          {!isGithub && !isYoutube && (
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          )}

          <span>{link.label}</span>
        </Button>
      );
    })}

    {!hasLinks && (
      <span class="text-xs text-md-on-surface-variant/80 italic inline-flex items-center gap-1.5 py-1">
        <svg class="w-4 h-4 text-md-on-surface-variant/60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        Registro histórico sin repositorio público
      </span>
    )}
  </div>
</Card>

