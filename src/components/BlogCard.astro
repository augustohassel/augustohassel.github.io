---
import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import Card from './Card.astro';
import { formatDateShort, toISODateString } from '../utils/date';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  post: CollectionEntry<'blog'>;
  href: string;
  locale: Locale;
  isSpanishOnly?: boolean;
}

const { post, href, locale, isSpanishOnly = false } = Astro.props;
const t = useTranslations(locale);
const formattedDate = formatDateShort(post.data.date, locale);
const isoDate = toISODateString(post.data.date);
---

<article data-category={post.data.category} class="post-card flex flex-col h-full">
  <Card
    as="a"
    href={href}
    variant="outlined"
    class="flex-1 flex flex-col justify-between sm:p-7 hover:border-md-primary/60 hover:shadow-m3-2 transition-all duration-300 group"
  >
    <div class="space-y-4">
      <!-- Metadatos superiores: Categoría, Badge de idioma si es post solo en español, y Fecha -->
      <div class="flex items-center justify-between gap-2 text-xs flex-wrap">
        <div class="flex items-center gap-1.5 flex-wrap">
          <Badge
            variant={post.data.category === 'Archivo / R' ? 'secondary' : 'primary'}
            size="sm"
          >
            {post.data.category}
          </Badge>
          {isSpanishOnly && (
            <span
              class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border border-md-outline-variant/60 text-md-on-surface-variant bg-md-surface-container-low"
              title={t('blog.spanishOnlyNotice')}
            >
              {t('blog.spanishOnlyBadge')}
            </span>
          )}
        </div>
        <time datetime={isoDate} class="text-md-on-surface-variant font-medium">
          {formattedDate}
        </time>
      </div>

      <!-- Título -->
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-md-on-surface group-hover:text-md-primary transition-colors leading-snug">
        {post.data.title}
      </h2>

      <!-- Descripción -->
      <p class="text-sm text-md-on-surface-variant leading-relaxed line-clamp-3">
        {post.data.description}
      </p>
    </div>

    <!-- Footer de la tarjeta: Tags y enlace de lectura -->
    <div class="pt-6 mt-4 border-t border-md-outline-variant/20 flex items-center justify-between gap-2">
      <div class="flex flex-wrap items-center gap-1.5 overflow-hidden">
        {post.data.tags.slice(0, 3).map((tag) => (
          <span class="text-[11px] px-2 py-0.5 rounded-md bg-md-surface-container text-md-on-surface-variant font-medium">
            #{tag}
          </span>
        ))}
      </div>

      <span class="inline-flex items-center gap-1 text-xs font-semibold text-md-primary group-hover:translate-x-1 transition-transform flex-shrink-0">
        <span>{t('blog.readMore')}</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </span>
    </div>
  </Card>
</article>

