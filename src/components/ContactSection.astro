---
import Card from './Card.astro';
import Badge from './Badge.astro';
import Button from './Button.astro';
---

<section id="contacto" class="scroll-mt-20 py-12 sm:py-16 border-t border-md-outline-variant/20">
  <div class="max-w-2xl mx-auto text-center space-y-6">
    <div class="inline-flex items-center gap-2">
      <Badge variant="primary" size="md">
        Contacto
      </Badge>
    </div>

    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-md-on-surface">
      Hablemos
    </h2>

    <p class="text-base sm:text-lg text-md-on-surface-variant leading-relaxed">
      ¿Tenés alguna consulta, proyecto o te interesa conversar sobre software, finanzas o inteligencia artificial? Podés escribirme directamente.
    </p>

    <Card variant="filled" class="p-6 sm:p-8 space-y-5 text-center">
      <span class="text-xs uppercase tracking-wider text-md-on-surface-variant font-medium">
        Correo profesional
      </span>
      <div class="text-xl sm:text-2xl font-bold font-mono text-md-primary select-all break-all">
        augusto@hasselpunk.com
      </div>
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
        <!-- Acción principal: Copiar dirección con feedback instantáneo -->
        <button
          id="copy-email-btn"
          type="button"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-sm font-semibold bg-md-primary text-md-on-primary hover:bg-md-primary/90 transition-all shadow-m3-1 focus:outline-none focus:ring-2 focus:ring-md-primary focus:ring-offset-2 cursor-pointer"
          data-email="augusto@hasselpunk.com"
          aria-label="Copiar dirección de correo al portapapeles"
        >
          <svg id="copy-icon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <svg id="check-icon" class="w-4 h-4 hidden text-emerald-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span id="copy-btn-text">Copiar dirección</span>
        </button>

        <!-- Acción webmail: Abrir directamente en Gmail (garantizado en el navegador) -->
        <Button
          as="a"
          href="https://mail.google.com/mail/?view=cm&fs=1&to=augusto@hasselpunk.com"
          target="_blank"
          rel="noopener noreferrer"
          variant="tonal"
          aria-label="Redactar correo a augusto@hasselpunk.com en Gmail web (abre en nueva pestaña)"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z"/>
          </svg>
          Abrir en Gmail
        </Button>
      </div>

      <!-- Fallback cliente de correo nativo (mailto) -->
      <div class="pt-2">
        <a
          href="mailto:augusto@hasselpunk.com"
          class="text-xs text-md-on-surface-variant hover:text-md-primary underline transition-colors"
          title="Abrir en cliente de correo predeterminado del sistema operativo"
        >
          O abrir con tu app de correo predeterminada (mailto)
        </a>
      </div>
    </Card>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');
  const copyText = document.getElementById('copy-btn-text');

  if (copyBtn && copyText && copyIcon && checkIcon) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || 'augusto@hasselpunk.com';
      try {
        await navigator.clipboard.writeText(email);
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        copyText.textContent = '¡Copiado al portapapeles!';
        setTimeout(() => {
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
          copyText.textContent = 'Copiar dirección';
        }, 2500);
      } catch (err) {
        copyText.textContent = email;
      }
    });
  }
</script>
