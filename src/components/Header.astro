---
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';

interface NavItem {
  label: string;
  href: string;
}

const navItems: NavItem[] = [
  { label: 'Inicio', href: '/' },
  { label: 'Sobre mí', href: '/#sobre-mi' },
  { label: 'Proyectos', href: '/#proyectos' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contacto', href: '/#contacto' },
];
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-md-surface/85 border-b border-md-outline-variant/30 transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Logotipo con Isotipo HasselPunk -->
    <a
      href="/"
      class="flex items-center gap-3 font-semibold text-lg text-md-on-surface hover:text-md-primary transition-colors focus:outline-none focus:ring-2 focus:ring-md-primary rounded-lg px-1 py-1"
      aria-label="HasselPunk - Inicio"
    >
      <Logo size="md" />
      <span class="tracking-tight">Augusto Hassel</span>
    </a>

    <!-- Navegación y Conmutador de Tema -->
    <div class="flex items-center gap-2 sm:gap-6">
      <nav class="hidden sm:flex items-center gap-1" aria-label="Navegación principal">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="px-3 py-2 text-sm font-medium rounded-full text-md-on-surface-variant hover:text-md-on-surface hover:bg-md-surface-variant/40 transition-colors focus:outline-none focus:ring-2 focus:ring-md-primary"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="h-6 w-px bg-md-outline-variant/40 hidden sm:block"></div>

      <ThemeToggle />

      <!-- Botón de menú móvil (< sm) -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="sm:hidden relative inline-flex items-center justify-center w-10 h-10 rounded-full text-md-on-surface-variant hover:text-md-on-surface hover:bg-md-surface-variant/40 focus:outline-none focus:ring-2 focus:ring-md-primary transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
        title="Menú de navegación"
      >
        <svg
          id="mobile-menu-icon-open"
          class="w-6 h-6 block"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
        <svg
          id="mobile-menu-icon-close"
          class="w-6 h-6 hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú desplegable móvil -->
  <nav
    id="mobile-menu"
    class="hidden sm:hidden border-t border-md-outline-variant/30 bg-md-surface/95 backdrop-blur-md px-4 pt-2 pb-4 space-y-1 shadow-m3-2"
    aria-label="Navegación móvil"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        class="mobile-nav-link block px-4 py-2.5 text-base font-medium rounded-xl text-md-on-surface-variant hover:text-md-on-surface hover:bg-md-surface-variant/40 transition-colors focus:outline-none focus:ring-2 focus:ring-md-primary"
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script is:inline>
  (function () {
    const menuBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('mobile-menu-icon-open');
    const iconClose = document.getElementById('mobile-menu-icon-close');

    if (!menuBtn || !mobileMenu || !iconOpen || !iconClose) return;

    function setMenuOpen(isOpen) {
      mobileMenu.classList.toggle('hidden', !isOpen);
      iconOpen.classList.toggle('hidden', isOpen);
      iconClose.classList.toggle('hidden', !isOpen);
      menuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      menuBtn.setAttribute(
        'aria-label',
        isOpen ? 'Cerrar menú de navegación' : 'Abrir menú de navegación'
      );
    }

    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!isExpanded);
    });

    // Cerrar menú al hacer clic en un enlace (útil en enlaces de ancla como #sobre-mi)
    const links = mobileMenu.querySelectorAll('.mobile-nav-link');
    links.forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    // Cerrar menú al presionar Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        menuBtn.focus();
      }
    });
  })();
</script>

