---
import Card from './Card.astro';
import Badge from './Badge.astro';
import { pressMentions } from '../data/press';
---

<section id="prensa" class="scroll-mt-20 py-12 sm:py-16 border-t border-md-outline-variant/20">
  <div class="space-y-4">
    <div class="inline-flex items-center gap-2">
      <Badge variant="secondary" size="md">
        Cobertura & Publicaciones
      </Badge>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-md-on-surface">
          Prensa y Notas
        </h2>
        <p class="text-base text-md-on-surface-variant mt-2 max-w-2xl leading-relaxed">
          Menciones periodísticas verificadas en medios de negocios y reflexiones autobiográficas sobre el ciclo de vida de startups, fintech y software.
        </p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-8">
    {pressMentions.map((item) => (
      <Card
        variant={item.category === 'autor' ? 'filled' : 'outlined'}
        class="flex flex-col justify-between h-full space-y-4 hover:border-md-primary/50 group"
      >
        <div class="space-y-3">
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 flex-wrap">
              <Badge variant={item.category === 'autor' ? 'primary' : 'outline'} size="sm">
                {item.media}
              </Badge>
              {item.badge && (
                <span class="text-xs font-medium text-md-primary px-2 py-0.5 rounded-full bg-md-primary-container/40">
                  {item.badge}
                </span>
              )}
            </div>
            <span class="text-xs font-mono text-md-on-surface-variant whitespace-nowrap">
              {item.date}
            </span>
          </div>

          <h3 class="text-lg sm:text-xl font-bold text-md-on-surface group-hover:text-md-primary transition-colors leading-snug">
            {item.title}
          </h3>

          <p class="text-sm text-md-on-surface-variant leading-relaxed">
            {item.excerpt}
          </p>
        </div>

        <div class="pt-4 border-t border-md-outline-variant/20 flex items-center justify-between">
          <span class="text-xs text-md-on-surface-variant font-medium">
            {item.category === 'autor' ? 'Publicación de autor' : 'Nota externa'}
          </span>
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-md-primary hover:text-md-primary/80 transition-colors focus:outline-none focus:ring-2 focus:ring-md-primary rounded px-2 py-1"
            aria-label={`Leer: "${item.title}" en ${item.media} (abre en nueva pestaña)`}
          >
            <span>{item.category === 'autor' ? 'Leer artículo' : 'Ver nota'}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </Card>
    ))}
  </div>
</section>

