---
import { socialLinks } from '../data/social';

const currentYear = new Date().getFullYear();
---

<footer class="w-full mt-auto border-t border-md-outline-variant/30 bg-md-surface-container-low transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div>
        <p class="font-medium text-md-on-surface">
          HasselPunk · Augusto Hassel
        </p>
        <p class="text-xs text-md-on-surface-variant mt-1">
          Construido con Astro 5, Tailwind CSS y principios de Material Design 3.
        </p>
      </div>

      <div class="flex items-center gap-4">
        {socialLinks.map((link) => (
          <a
            href={link.url}
            target={link.url.startsWith('mailto:') ? undefined : '_blank'}
            rel={link.url.startsWith('mailto:') ? undefined : 'me noopener noreferrer'}
            class="text-sm font-medium text-md-on-surface-variant hover:text-md-primary transition-colors focus:outline-none focus:ring-2 focus:ring-md-primary rounded px-2 py-1"
            aria-label={link.label}
          >
            {link.name}
          </a>
        ))}
      </div>
    </div>

    <div class="mt-6 pt-4 border-t border-md-outline-variant/20 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-md-on-surface-variant">
      <p>© {currentYear} Augusto Hassel. Todos los derechos reservados.</p>
      <p>www.hasselpunk.com</p>
    </div>
  </div>
</footer>

