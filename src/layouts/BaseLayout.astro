---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocaleFromUrl, useTranslations, type Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale?: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
  hreflangUrls?: Partial<Record<Locale | 'x-default', string>>;
}

const detectedLocale = getLocaleFromUrl(Astro.url);
const {
  locale = detectedLocale,
  title,
  description,
  image = "/img/hasselpunk-logo.jpeg",
  alternateUrls,
  hreflangUrls,
} = Astro.props;

const t = useTranslations(locale);
const pageTitle = title || t('meta.defaultTitle');
const pageDescription = description || t('meta.defaultDescription');

const siteOrigin = (Astro.site ? Astro.site.href : 'https://www.hasselpunk.com').replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);

function toAbsoluteUrl(path: string): string {
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  const normalized = path.startsWith('/') ? path : `/${path}`;
  return `${siteOrigin}${normalized}`;
}

// Cálculo determinista de etiquetas hreflang recíprocas
let computedHreflangs: { lang: string; url: string }[] = [];

if (hreflangUrls) {
  computedHreflangs = Object.entries(hreflangUrls).map(([lang, path]) => ({
    lang,
    url: toAbsoluteUrl(path),
  }));
} else {
  const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

  if (currentPath === '/blog' || currentPath === '/en/blog' || currentPath === '/de/blog') {
    computedHreflangs = [
      { lang: 'es', url: toAbsoluteUrl('/blog/') },
      { lang: 'en', url: toAbsoluteUrl('/en/blog/') },
      { lang: 'de', url: toAbsoluteUrl('/de/blog/') },
      { lang: 'x-default', url: toAbsoluteUrl('/blog/') },
    ];
  } else if (currentPath === '/' || currentPath === '/en' || currentPath === '/de') {
    computedHreflangs = [
      { lang: 'es', url: toAbsoluteUrl('/') },
      { lang: 'en', url: toAbsoluteUrl('/en/') },
      { lang: 'de', url: toAbsoluteUrl('/de/') },
      { lang: 'x-default', url: toAbsoluteUrl('/') },
    ];
  } else {
    computedHreflangs = [
      { lang: locale, url: canonicalURL.href },
      { lang: 'x-default', url: canonicalURL.href },
    ];
  }
}
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO hreflang para internacionalización recíproca -->
    {computedHreflangs.map(({ lang, url }) => (
      <link rel="alternate" hreflang={lang} href={url} />
    ))}

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content={image} />

    <title>{pageTitle}</title>

    <!-- Script Anti-FOUC con manejo seguro de localStorage y fallback prefers-color-scheme -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.remove('light');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
          }
        } catch (_) {
          // Fallback silencioso en entornos restringidos
        }
      })();
    </script>
  </head>
  <body class="bg-md-surface text-md-on-surface flex flex-col min-h-screen">
    <!-- Enlace accesible de salto al contenido principal -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-md-primary text-md-on-primary font-medium rounded-lg shadow-m3-2 focus:outline-none focus:ring-2 focus:ring-md-primary"
    >
      {t('a11y.skipToContent')}
    </a>

    <Header currentLocale={locale} alternateUrls={alternateUrls} />

    <main id="main-content" class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>

    <Footer currentLocale={locale} />
  </body>
</html>
