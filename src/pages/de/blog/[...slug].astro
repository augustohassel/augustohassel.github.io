---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const dePosts = allPosts.filter((p) => p.data.lang === 'de');

  return dePosts.map((post) => {
    let alternateUrls: Record<'es' | 'en' | 'de', string> = {
      es: '/blog/',
      en: '/en/blog/',
      de: `/de/blog/${post.id}/`,
    };

    let hreflangUrls: Partial<Record<'es' | 'en' | 'de' | 'x-default', string>> = {
      de: `/de/blog/${post.id}/`,
      'x-default': `/de/blog/${post.id}/`,
    };

    if (post.data.translationKey) {
      const esPost = allPosts.find(
        (p) => p.data.translationKey === post.data.translationKey && (p.data.lang ?? 'es') === 'es'
      );
      const enPost = allPosts.find(
        (p) => p.data.translationKey === post.data.translationKey && p.data.lang === 'en'
      );

      if (esPost) {
        alternateUrls.es = `/blog/${esPost.id}/`;
        hreflangUrls.es = `/blog/${esPost.id}/`;
        hreflangUrls['x-default'] = `/blog/${esPost.id}/`;
      }
      if (enPost) {
        alternateUrls.en = `/en/blog/${enPost.id}/`;
        hreflangUrls.en = `/en/blog/${enPost.id}/`;
      }
    }

    return {
      params: { slug: post.id },
      props: { post, alternateUrls, hreflangUrls },
    };
  });
}

const { post, alternateUrls, hreflangUrls } = Astro.props;
const { Content } = await render(post);
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  author={post.data.author}
  category={post.data.category}
  tags={post.data.tags}
  image={post.data.image}
  locale="de"
  alternateUrls={alternateUrls}
  hreflangUrls={hreflangUrls}
>
  <Content />
</BlogPostLayout>

