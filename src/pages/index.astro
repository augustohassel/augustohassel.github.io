---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import AboutMe from '../components/AboutMe.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ContactSection from '../components/ContactSection.astro';

const title = "Augusto Hassel | HasselPunk";
const description = "Sitio personal y portfolio profesional de Augusto Hassel. Desarrollo de software y tecnología aplicada a finanzas e inteligencia artificial.";
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section -->
  <section class="py-12 sm:py-16 text-center space-y-6">
    <div class="inline-flex items-center gap-2">
      <Badge variant="primary" size="md">
        <span class="w-2 h-2 rounded-full bg-md-primary animate-pulse"></span>
        HasselPunk · Sitio Personal & Portfolio
      </Badge>
    </div>

    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-md-on-surface">
      Augusto Hassel
    </h1>

    <p class="max-w-2xl mx-auto text-lg sm:text-xl text-md-on-surface-variant leading-relaxed">
      Desarrollo de software y tecnología aplicada a <span class="font-semibold text-md-on-surface">finanzas</span> e <span class="font-semibold text-md-on-surface">inteligencia artificial</span>.
    </p>

    <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
      <Button
        as="a"
        href="#sobre-mi"
        variant="filled"
      >
        Conocer más sobre mí
      </Button>

      <Button
        as="a"
        href="#proyectos"
        variant="tonal"
      >
        Ver proyectos
      </Button>

      <Button
        as="a"
        href="#contacto"
        variant="outlined"
      >
        Contacto directo
      </Button>
    </div>
  </section>

  <!-- Sección Sobre Mí (Bio, Foto optimizada, redes y nota de Parra) -->
  <AboutMe />

  <!-- Sección Portfolio de Proyectos -->
  <ProjectsSection />

  <!-- Sección de Contacto -->
  <ContactSection />
</BaseLayout>
